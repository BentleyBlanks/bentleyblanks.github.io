    {
     "id": "NoWayAround.02",
     "keyframe": "08-2",
     "who": "geng",
     "speaker": "老耿",
     "lang": "zhNorth",
     "subtitle": "西边是河汊子，沟帮子陡，车下不去。",
     "text": "西边是河汊子，沟帮子陡，车下不去。",
