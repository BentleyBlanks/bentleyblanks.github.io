     "durationS": 3.1,
     "gapBeforeS": 0,
     "sha256": "e0d66aa993e2324b63cbb733a833214506ae059495c1fd1279a1e7f15e825096",
     "speakerCos": 0.863,
     "cer": 0.1429,
     "transcript": "西边是河岛子,沟帮子斗,车下不去。"
    },
    {
     "id": "NoWayAround.03",
     "keyframe": "08-2",
     "who": "luo",
     "speaker": "罗班长",
     "lang": "zh",
     "subtitle": "硬冲就是送死。等天黑，摸进去。",
