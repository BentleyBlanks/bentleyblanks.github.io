     "gapBeforeS": 0.12,
     "sha256": "5ef91042a3d5fcce1bc8dac572ba13155568e81353d4b301f61954da58d52e2e",
     "speakerCos": 0.472,
     "cer": 0.1667,
     "transcript": "隐从就是送死,等天黑,摸进去。"
    },
