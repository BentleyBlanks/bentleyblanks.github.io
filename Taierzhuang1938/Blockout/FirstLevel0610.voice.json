    {
     "id": "CopperCoins.04",
     "keyframe": "07-1",
     "who": "yaowa",
     "speaker": "幺娃",
     "lang": "zh",
     "subtitle": "跟冬瓜？他都那个鬼样子了。",
     "text": "跟冬瓜？他都那个鬼样子了。",
     "file": "./Audio/Blockout0610/AudioVoice_Blockout0610CopperCoins_04.mp3",
