   "targetDb": -19,
   "cutMethod": "subtitle",
   "hard": [],
   "flags": [],
   "lines": [
    {
     "id": "DogHole.01",
     "keyframe": "08-3",
     "who": "geng",
     "speaker": "老耿",
     "lang": "zhNorth",
     "subtitle": "翻后墙不行，房顶上那个瞅得见。俺家后院跟邻院当间那道墙，墙根底下有个狗洞，房顶上瞅不着那儿。",
     "text": "翻后墙不行，房顶上那个瞅得见。俺家后院跟邻院当间那道墙，墙根底下有个狗洞，房顶上瞅不着那儿。",
     "file": "./Audio/Blockout0610/AudioVoice_Blockout0610DogHole_01.mp3",
     "durationS": 11.12,
     "gapBeforeS": 0,
     "sha256": "ed625fca837dfd1408c21af55022a5e0dcbc6038e1e5790eb33e0ab97c1157f3",
     "speakerCos": 0.946,
     "cer": 0.2927,
     "transcript": "翻后墙不行,房顶上那个丑的箭。安家后院,跟林院挡箭拿到墙。墙根底下有个狗洞,房顶上丑不着哪。"
    },
    {
     "id": "DogHole.02",
     "keyframe": "08-3",
     "who": "geng",
     "speaker": "老耿",
     "lang": "zhNorth",
     "subtitle": "狗洞大人钻不进去。侧门从里头闩着。",
     "text": "狗洞大人钻不进去。侧门从里头闩着。",
     "file": "./Audio/Blockout0610/AudioVoice_Blockout0610DogHole_02.mp3",
     "durationS": 6.13,
     "gapBeforeS": 0.9,
     "sha256": "018840822d9d0a18b4000efcfec1a528c38c3f08c903cf86abdc0bdb35a27dc2",
     "speakerCos": 0.9,
     "cer": 0.1333,
     "transcript": "狗洞大人转不进去,侧门从里头拴着。"
    },
    {
     "id": "DogHole.03",
     "keyframe": "08-3",
     "who": "shunzi",
     "speaker": "顺子",
     "lang": "zh",
     "subtitle": "老子去门口等到。",
     "text": "老子去门口等到。",
     "file": "./Audio/Blockout0610/AudioVoice_Blockout0610DogHole_03.mp3",
     "durationS": 1.07,
     "gapBeforeS": 0.25,
     "sha256": "d76bb9486f7ec13cb35807ac7ff0456b2bd8d74111975f47f4eb3d7cf869788d",
     "speakerCos": 0.646,
     "cer": 0.2857,
     "transcript": "老子请门口灯到。"
    },
    {
     "id": "DogHole.04",
     "keyframe": "08-3",
     "who": "luo",
     "speaker": "罗班长",
     "lang": "zh",
     "subtitle": "我这儿一杆枪都抽不出来，你一个人去。",
     "text": "我这儿一杆枪都抽不出来，你一个人去。",
     "file": "./Audio/Blockout0610/AudioVoice_Blockout0610DogHole_04.mp3",
     "durationS": 3.21,
     "gapBeforeS": 0.17,
     "sha256": "af1c54cf451ca9748456a54150a5a51f171491ca47c6d391a0cbd4bce250391b",
     "speakerCos": 0.855,
     "cer": 0.0625,
     "transcript": "我这儿一杆墙都抽不出来。你一个人去。"
    },
    {
     "id": "DogHole.05",
     "keyframe": "08-3",
     "who": "yaowa",
     "speaker": "幺娃",
     "lang": "zh",
     "subtitle": "顺儿哥，你龟儿疯了嗦？",
     "text": "顺儿哥，你龟儿疯了嗦？",
     "file": "./Audio/Blockout0610/AudioVoice_Blockout0610DogHole_05.mp3",
     "durationS": 1.87,
     "gapBeforeS": 0.17,
     "sha256": "237494c67781f1282db546ca4cbdb53563b3e356cae46ff4fc8b601f2cf82388",
     "speakerCos": 0.604,
     "cer": 0.5556,
     "transcript": "四哥,你不是疯了吗?",
     "issues": [
      "字错率 0.5556 待人耳核对"
     ]
    },
    {
     "id": "DogHole.06",
     "keyframe": "08-3",
     "who": "shunzi",
     "speaker": "顺子",
     "lang": "zh",
     "subtitle": "冬瓜等不到天黑。他一死，老子这辈子都回不去了。",
     "text": "冬瓜等不到天黑。他一死，老子这辈子都回不去了。",
     "file": "./Audio/Blockout0610/AudioVoice_Blockout0610DogHole_06.mp3",
     "durationS": 5.7,
     "gapBeforeS": 0.39,
     "sha256": "c3a5846b391ad599e25cba5c49f41e891f2fec3e7ec2acf89ae36b15c8384e8f",
     "speakerCos": 0.673,
     "cer": 0.2,
     "transcript": "冬瓜灯不到天黑,它已死,老子再辈子都回不去了。"
    }
   ]
