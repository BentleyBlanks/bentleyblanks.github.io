{
  "lines": [
    { "key": "prologue_young_dispatch_01", "file": "AudioSfx_PrologueVoiceYoungDispatch_01.mp3", "voice": "YoungDispatch", "text": "我们出川好久了哦。" },
    { "key": "prologue_old_wound_01", "file": "AudioSfx_PrologueVoiceOldWound_01.mp3", "voice": "OldWound", "text": "路莫问，跟到走就是。" },
    { "key": "prologue_young_dispatch_02", "file": "AudioSfx_PrologueVoiceYoungDispatch_02.mp3", "voice": "YoungDispatch", "text": "我都忘了屋头腊肉是啥味道了。" },
    { "key": "prologue_machine_gunner_01", "file": "AudioSfx_PrologueVoiceMachineGunner_01.mp3", "voice": "MachineGunner", "text": "你娃儿还惦记腊肉。" },
    { "key": "prologue_young_dispatch_03", "file": "AudioSfx_PrologueVoiceYoungDispatch_03.mp3", "voice": "YoungDispatch", "text": "不惦记吃的惦记啥子嘛。" },
    { "key": "prologue_machine_gunner_02", "file": "AudioSfx_PrologueVoiceMachineGunner_02.mp3", "voice": "MachineGunner", "text": "到了前头，有热水喝你就谢天谢地。" },
    { "key": "prologue_rifleman_01", "file": "AudioSfx_PrologueVoiceRifleman_01.mp3", "voice": "Rifleman", "text": "又卡。" },
    { "key": "prologue_old_wound_02", "file": "AudioSfx_PrologueVoiceOldWound_02.mp3", "voice": "OldWound", "text": "你少骂两句，它兴许听话点。" },
    { "key": "prologue_squad_leader_01", "file": "AudioSfx_PrologueVoiceSquadLeader_01.mp3", "voice": "SquadLeader", "text": "莫摆了。线盘再检查一遍，到了地头就要用。" },
    { "key": "prologue_old_wound_03", "file": "AudioSfx_PrologueVoiceOldWound_03.mp3", "voice": "OldWound", "text": "近咯。" },
    { "key": "prologue_squad_leader_02", "file": "AudioSfx_PrologueVoiceSquadLeader_02.mp3", "voice": "SquadLeader", "text": "都醒起，装备拿好。" },
    { "key": "prologue_external_officer_01", "file": "AudioSfx_PrologueVoiceExternalOfficer_01.mp3", "voice": "ExternalOfficer", "text": "通信排，下车！线盘背起，搞快！" }
  ]
}
