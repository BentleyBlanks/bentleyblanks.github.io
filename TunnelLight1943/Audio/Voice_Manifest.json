{
  "lines": [
    {
      "id": "1vs3d4b",
      "who": "伪军",
      "text": "出来！都出来！",
      "voice": "Traitor",
      "dur": 2.412
    },
    {
      "id": "03xlx9i",
      "who": "娘",
      "text": "柱子。",
      "voice": "Mother",
      "dur": 1.332
    },
    {
      "id": "02tb7jf",
      "who": "娘",
      "text": "抱她。",
      "voice": "Mother",
      "dur": 1.476
    },
    {
      "id": "0jrk34k",
      "who": "娘",
      "text": "快。",
      "voice": "Mother",
      "dur": 1.296
    },
    {
      "id": "036qzcq",
      "who": "娘",
      "text": "下去！",
      "voice": "Mother",
      "dur": 1.62
    },
    {
      "id": "16mcmjl",
      "who": "娘",
      "text": "搂紧她。",
      "voice": "Mother",
      "dur": 1.656
    },
    {
      "id": "0nq13hp",
      "who": "娘",
      "text": "不叫你们，别上来。",
      "voice": "Mother",
      "dur": 2.304
    },
    {
      "id": "1azw048",
      "who": "娘的声音",
      "text": "留种。谁也不能动。",
      "voice": "Mother"
    },
    {
      "id": "1xf8oop",
      "who": "妹妹",
      "text": "哥？",
      "voice": "Sister"
    },
    {
      "id": "0d3ir4g",
      "who": "妹妹",
      "text": "你上哪了？",
      "voice": "Sister"
    },
    {
      "id": "05haxtn",
      "who": "柱子",
      "text": "没上哪。",
      "voice": "Zhuzi"
    },
    {
      "id": "06yldyd",
      "who": "柱子",
      "text": "吃你的。",
      "voice": "Zhuzi"
    },
    {
      "id": "19cgshz",
      "who": "妹妹",
      "text": "今天还画吗？",
      "voice": "Sister"
    },
    {
      "id": "0yayqj5",
      "who": "柱子",
      "text": "画。",
      "voice": "Zhuzi"
    },
    {
      "id": "0k2vkwj",
      "who": "妹妹",
      "text": "一。",
      "voice": "Sister"
    },
    {
      "id": "048aiv3",
      "who": "妹妹",
      "text": "二。",
      "voice": "Sister"
    },
    {
      "id": "0nzeapq",
      "who": "妹妹",
      "text": "三。",
      "voice": "Sister"
    },
    {
      "id": "0q8csj1",
      "who": "妹妹",
      "text": "爹上回出门，画到第四道就回来了。",
      "voice": "Sister"
    },
    {
      "id": "0pho2gf",
      "who": "妹妹",
      "text": "他们啥时候回来？",
      "voice": "Sister"
    },
    {
      "id": "1cvsaxp",
      "who": "柱子",
      "text": "快了。",
      "voice": "Zhuzi"
    },
    {
      "id": "1v6705a",
      "who": "柱子",
      "text": "俺去打水。",
      "voice": "Zhuzi"
    },
    {
      "id": "14rq44s",
      "who": "柱子",
      "text": "你跟紧。",
      "voice": "Zhuzi"
    },
    {
      "id": "0zfsqib",
      "who": "妹妹",
      "text": "哥，大的。",
      "voice": "Sister"
    },
    {
      "id": "1qwz605",
      "who": "柱子",
      "text": "嗯。",
      "voice": "Zhuzi"
    },
    {
      "id": "040cvvf",
      "who": "柱子",
      "text": "搁兜里。",
      "voice": "Zhuzi"
    },
    {
      "id": "1ozag1k",
      "who": "柱子",
      "text": "走了。",
      "voice": "Zhuzi"
    },
    {
      "id": "1bck90e",
      "who": "伪军",
      "text": "谁在那儿？",
      "voice": "Traitor"
    },
    {
      "id": "1c0wtbj",
      "who": "七叔",
      "text": "铃一响就躲。",
      "voice": "Elder"
    },
    {
      "id": "1s48bjc",
      "who": "七叔",
      "text": "好小子。",
      "voice": "Elder"
    },
    {
      "id": "01ci7fi",
      "who": "七叔",
      "text": "这两天甭往北头去。听见没？",
      "voice": "Elder"
    },
    {
      "id": "0qbdg8b",
      "who": "七叔",
      "text": "晚上过来吃。",
      "voice": "Elder"
    },
    {
      "id": "0nhuka8",
      "who": "七叔",
      "text": "你婶子熬了糊糊。",
      "voice": "Elder"
    },
    {
      "id": "1gcat97",
      "who": "柱子",
      "text": "不了。",
      "voice": "Zhuzi"
    },
    {
      "id": "1xbny02",
      "who": "七叔",
      "text": "你家那二亩地，明儿我把牲口牵过来。",
      "voice": "Elder"
    },
    {
      "id": "162rh27",
      "who": "柱子",
      "text": "七叔——",
      "voice": "Zhuzi"
    },
    {
      "id": "0u0e36l",
      "who": "七叔",
      "text": "你爹那年借我三斗谷子。",
      "voice": "Elder"
    },
    {
      "id": "0f0ylwc",
      "who": "柱子",
      "text": "俺爹没——",
      "voice": "Zhuzi"
    },
    {
      "id": "0zse85s",
      "who": "七叔",
      "text": "我说有。",
      "voice": "Elder"
    },
    {
      "id": "1skv5ny",
      "who": "七叔",
      "text": "就有。",
      "voice": "Elder"
    },
    {
      "id": "1u8dfbc",
      "who": "妹妹",
      "text": "哥，你也吃。",
      "voice": "Sister"
    },
    {
      "id": "1kvyx8j",
      "who": "柱子",
      "text": "涮锅水。",
      "voice": "Zhuzi"
    },
    {
      "id": "1s27r35",
      "who": "柱子",
      "text": "别糟践了。",
      "voice": "Zhuzi"
    },
    {
      "id": "1uwl6rc",
      "who": "妹妹",
      "text": "哥……",
      "voice": "Sister"
    },
    {
      "id": "117vxyo",
      "who": "妹妹",
      "text": "冷。",
      "voice": "Sister"
    },
    {
      "id": "17ohhrc",
      "who": "陌生人",
      "text": "水。",
      "voice": "Elder"
    },
    {
      "id": "0602h6i",
      "who": "妹妹",
      "text": "哥。",
      "voice": "Sister"
    },
    {
      "id": "1qe7uf6",
      "who": "妹妹",
      "text": "我喊你了。",
      "voice": "Sister"
    },
    {
      "id": "1o50ipd",
      "who": "妹妹",
      "text": "可大声了。",
      "voice": "Sister"
    },
    {
      "id": "10r5hrg",
      "who": "妹妹",
      "text": "我当你也走了。",
      "voice": "Sister"
    },
    {
      "id": "1aqvgbd",
      "who": "柱子",
      "text": "没走。",
      "voice": "Zhuzi"
    },
    {
      "id": "1e762yj",
      "who": "柱子",
      "text": "我去拿水。",
      "voice": "Zhuzi"
    },
    {
      "id": "0cw93iz",
      "who": "柱子",
      "text": "你回屋。",
      "voice": "Zhuzi"
    },
    {
      "id": "068uf0x",
      "who": "柱子",
      "text": "我在。",
      "voice": "Zhuzi"
    },
    {
      "id": "1yblh6c",
      "who": "七叔",
      "text": "柱子！开窖口！",
      "voice": "Elder"
    },
    {
      "id": "11zx67v",
      "who": "七叔",
      "text": "……要开了。",
      "voice": "Elder"
    },
    {
      "id": "1jwejvg",
      "who": "七叔",
      "text": "这洞……通到我家柴房底下去！是老辈人打的防兵洞！",
      "voice": "Elder"
    },
    {
      "id": "1woxvd0",
      "who": "七叔",
      "text": "钻！小的先走！",
      "voice": "Elder"
    },
    {
      "id": "10r2840",
      "who": "七叔",
      "text": "光躲不行。得想办法打。",
      "voice": "Elder"
    },
    {
      "id": "1r5jx8c",
      "who": "大娘",
      "text": "孩子，帮我找找柴刀——手一抖，掉进田埂那头了。",
      "voice": "Mother",
      "dur": 5.37
    },
    {
      "id": "1iqfyzo",
      "who": "赶车乡亲",
      "text": "给据点支差送草——车陷在这儿了。搭把手；躲着点巡逻的。",
      "voice": "Militia",
      "dur": 5.86
    },
    {
      "id": "1e5ktsg",
      "who": "高传宝",
      "text": "梁家村的柱子？",
      "voice": "GaoChuanbao",
      "dur": 1.18
    },
    {
      "id": "02bl0b1",
      "who": "高传宝",
      "text": "你爹以前帮过乡亲。",
      "voice": "GaoChuanbao",
      "dur": 1.89
    },
    {
      "id": "0iow91j",
      "who": "交通员",
      "text": "据点里又抓了几个人。柱子的妹妹，也在里面。",
      "voice": "Militia",
      "dur": 4.45
    },
    {
      "id": "0kmncfm",
      "who": "高传宝",
      "text": "先把人救出来。不能让乡亲们再被带走。",
      "voice": "GaoChuanbao",
      "dur": 4.43
    },
    {
      "id": "1ot20mi",
      "who": "高传宝",
      "text": "想救人，先学会怎么把人藏好。",
      "voice": "GaoChuanbao",
      "dur": 3.24
    },
    {
      "id": "0z5idaw",
      "who": "民兵",
      "text": "鬼子发现东口了！",
      "voice": "Militia",
      "dur": 1.62
    },
    {
      "id": "0genp2f",
      "who": "高传宝",
      "text": "准备下一次行动。",
      "voice": "GaoChuanbao",
      "dur": 1.6
    },
    {
      "id": "0g36xue",
      "who": "高传宝",
      "text": "缺什么，上去拿。什么时候上去，你们自己看。",
      "voice": "GaoChuanbao",
      "dur": 4.89
    },
    {
      "id": "18xbokb",
      "who": "年轻民兵",
      "text": "带乡亲们走。",
      "voice": "Militia",
      "dur": 1.23
    },
    {
      "id": "1n1ts0l",
      "who": "高传宝",
      "text": "你说说看。",
      "voice": "GaoChuanbao",
      "dur": 0.87
    },
    {
      "id": "06aujs8",
      "who": "高传宝",
      "text": "套是套。人，也是真的人。",
      "voice": "GaoChuanbao",
      "dur": 2.86
    },
    {
      "id": "0i41772",
      "who": "高传宝",
      "text": "他们要的不是这十几个乡亲。是来救乡亲的人。",
      "voice": "GaoChuanbao",
      "dur": 4.75
    },
    {
      "id": "0ft4qpy",
      "who": "柱子",
      "text": "我去。",
      "voice": "Zhuzi",
      "dur": 0.59
    },
    {
      "id": "0wtthzw",
      "who": "高传宝",
      "text": "跟紧队伍。",
      "voice": "GaoChuanbao",
      "dur": 0.88
    },
    {
      "id": "1u72yhv",
      "who": "妹妹",
      "text": "哥，娘呢？",
      "voice": "Sister",
      "dur": 0.94
    },
    {
      "id": "02dqiaq",
      "who": "民兵",
      "text": "还有人没出来！东边旁洞里，还有几个乡亲！",
      "voice": "Militia",
      "dur": 4.79
    },
    {
      "id": "0rb1r1z",
      "who": "民兵",
      "text": "柱子，地道那边还缺人。",
      "voice": "Militia",
      "dur": 2.22
    },
    {
      "id": "1ymfd34",
      "who": "老人",
      "text": "梁家的柱子？你妹妹呢？",
      "voice": "Elder",
      "dur": 2.61
    },
    {
      "id": "1yn6f7c",
      "who": "柱子",
      "text": "送出去了。",
      "voice": "Zhuzi",
      "dur": 0.96
    },
    {
      "id": "1cfgkk6",
      "who": "",
      "text": "没人来叫。",
      "voice": "Narrator",
      "dur": 1.332
    },
    {
      "id": "1akb3yx",
      "who": "",
      "text": "第三天。还是没人来叫。",
      "voice": "Narrator"
    },
    {
      "id": "1dqgj0f",
      "who": "",
      "text": "谷雨过了。门框上的正字，添到了第十三道。",
      "voice": "Narrator"
    },
    {
      "id": "017w9em",
      "who": "",
      "text": "这天晌午，村东头的乌鸦轰的一声全飞起来了。",
      "voice": "Narrator"
    },
    {
      "id": "0ieboum",
      "who": "",
      "text": "鬼子又进村了。这一回是梳篦式的——一条街一条街，一户不落。",
      "voice": "Narrator"
    },
    {
      "id": "1yebj5k",
      "who": "",
      "text": "跑不赢了。街上已经过不去人。",
      "voice": "Narrator"
    },
    {
      "id": "0nt9g43",
      "who": "",
      "text": "田大爷胸口拉风箱似的响。他把咳压在嗓子眼里，压一下，抖一下。",
      "voice": "Narrator"
    },
    {
      "id": "1b12mn6",
      "who": "",
      "text": "刘嫂把水葫芦倒过来。空的。",
      "voice": "Narrator"
    },
    {
      "id": "1bon6fv",
      "who": "",
      "text": "头顶的脚步还没走利索。可这咳，也压不了几响了。",
      "voice": "Narrator"
    },
    {
      "id": "08193ha",
      "who": "",
      "text": "水一口一口顺下去。咳，压住了。",
      "voice": "Narrator"
    },
    {
      "id": "03n4s7u",
      "who": "",
      "text": "田大爷抬起眼皮看了看他，没说话。",
      "voice": "Narrator"
    },
    {
      "id": "1qcxnbs",
      "who": "",
      "text": "柱子把布巾叠成三折，递了过去。",
      "voice": "Narrator"
    },
    {
      "id": "1thngyz",
      "who": "",
      "text": "田大爷咬住。咳声闷在布里，一声，一声。",
      "voice": "Narrator"
    },
    {
      "id": "1epemg9",
      "who": "",
      "text": "妹妹把脸埋进柱子怀里。谁也没看谁。",
      "voice": "Narrator"
    },
    {
      "id": "0q4unjp",
      "who": "",
      "text": "头顶的脚步，忽然停在了屋当间。",
      "voice": "Narrator"
    },
    {
      "id": "0v70fw3",
      "who": "",
      "text": "枪托笃、笃地砸着地。砸到窖口那一下——声音是空的。",
      "voice": "Narrator"
    },
    {
      "id": "0tdzdpb",
      "who": "",
      "text": "上面静了静。跟着，有什么顺着盖板缝别了进来——盖板让它撬得翘起一条缝。",
      "voice": "Narrator"
    },
    {
      "id": "1xqef2o",
      "who": "",
      "text": "柱子退到窖底最里头。脚跟碾着的那块土——是松的。",
      "voice": "Narrator"
    },
    {
      "id": "1xnz4h8",
      "who": "",
      "text": "从七叔家柴房的旧窖口爬上来，天光晃得人睁不开眼。",
      "voice": "Narrator"
    },
    {
      "id": "09064sc",
      "who": "",
      "text": "街上的动静，还堵在村西头。谁也没说话，先喘。",
      "voice": "Narrator"
    },
    {
      "id": "00d0dcj",
      "who": "",
      "text": "田大爷靠着柴垛，咳出了声——这回，不用捂了。",
      "voice": "Narrator"
    },
    {
      "id": "15jhq8n",
      "who": "",
      "text": "柱子回过头。",
      "voice": "Narrator"
    },
    {
      "id": "030isz6",
      "who": "",
      "text": "柴房底下，那个黑黢黢的洞口，像一只睁开的眼睛。",
      "voice": "Narrator"
    },
    {
      "id": "18wwm8g",
      "who": "",
      "text": "他头一回觉得，那底下不是个坟墓。",
      "voice": "Narrator"
    },
    {
      "id": "0fkafls",
      "who": "",
      "text": "是个起点。",
      "voice": "Narrator"
    },
    {
      "id": "17ci9jy",
      "who": "",
      "text": "乡亲们说，被抓的人关进了河东的据点。",
      "voice": "Narrator",
      "dur": 3.93
    },
    {
      "id": "13gmty1",
      "who": "",
      "text": "柱子沿着运输队的车辙，摸到了据点外的庄稼地。",
      "voice": "Narrator",
      "dur": 4.4
    },
    {
      "id": "1hf3lkc",
      "who": "",
      "text": "他不敢靠近。他先学会了看。",
      "voice": "Narrator",
      "dur": 3.66
    },
    {
      "id": "119yk4y",
      "who": "",
      "text": "岗楼上那两个人换班的时候，背是朝着南门的。",
      "voice": "Narrator",
      "dur": 4.69
    },
    {
      "id": "133dx4y",
      "who": "",
      "text": "从背过身到重新站定，大约半袋烟的工夫。",
      "voice": "Narrator",
      "dur": 4.29
    },
    {
      "id": "1blw197",
      "who": "",
      "text": "巡逻队沿着墙根来回走。走到头，会停下来抽袋烟。",
      "voice": "Narrator",
      "dur": 6.33
    },
    {
      "id": "1pm8cmu",
      "who": "",
      "text": "牢房在东边。白天押着人往围墙上搬土袋。",
      "voice": "Narrator",
      "dur": 5.15
    },
    {
      "id": "0tllr43",
      "who": "",
      "text": "门里拴着一辆骡车。车辕上空着。",
      "voice": "Narrator",
      "dur": 4.02
    },
    {
      "id": "0bturhm",
      "who": "",
      "text": "身后突然伸过来一只手，把柱子整个按进田埂下面。",
      "voice": "Narrator",
      "dur": 5.4
    },
    {
      "id": "0dbwbrv",
      "who": "",
      "text": "巡逻队的脚步声从头顶的田埂上过去了。",
      "voice": "Narrator",
      "dur": 4.08
    },
    {
      "id": "193nbog",
      "who": "",
      "text": "沟里蹲着几个背枪的庄稼人。领头的把他上下打量了一遍。",
      "voice": "Narrator",
      "dur": 6.25
    },
    {
      "id": "19dia78",
      "who": "",
      "text": "柱子没敢答话。",
      "voice": "Narrator",
      "dur": 1.48
    },
    {
      "id": "0dkehge",
      "who": "",
      "text": "夜里，一个满身泥的交通员摸进沟来，鞋底磨穿了。",
      "voice": "Narrator",
      "dur": 5.36
    },
    {
      "id": "18bmt0s",
      "who": "",
      "text": "他的鞋底磨穿了。",
      "voice": "Narrator",
      "dur": 1.63
    },
    {
      "id": "02abmya",
      "who": "",
      "text": "鬼子放出风来，要往县里押人，日子没说定。",
      "voice": "Narrator",
      "dur": 4.64
    },
    {
      "id": "1qboovh",
      "who": "",
      "text": "沙河庄的地道，是乡亲们一锹一锹挖出来的。",
      "voice": "Narrator",
      "dur": 4.42
    },
    {
      "id": "1feuu6n",
      "who": "",
      "text": "它不通向据点。它通向的是：藏得住人，转移得走，活得下去。",
      "voice": "Narrator",
      "dur": 6.75
    },
    {
      "id": "16c31aq",
      "who": "",
      "text": "头顶传来闷响。泥土簌簌往下掉。",
      "voice": "Narrator",
      "dur": 4.21
    },
    {
      "id": "03kdrpm",
      "who": "",
      "text": "有人用本地口音在上面喊：地道口就在磨盘这一片，扒！",
      "voice": "Narrator",
      "dur": 5.83
    },
    {
      "id": "0o3jqzp",
      "who": "",
      "text": "一股呛人的烟，顺着东口灌了进来。",
      "voice": "Narrator",
      "dur": 3.56
    },
    {
      "id": "1ptfr39",
      "who": "",
      "text": "第二天，鬼子又拉来了水泵。",
      "voice": "Narrator",
      "dur": 2.75
    },
    {
      "id": "06jhzh2",
      "who": "",
      "text": "浑浊的泥水顺着东口灌下来，先淹的是最低的那一段。",
      "voice": "Narrator",
      "dur": 5.33
    },
    {
      "id": "0ooevgx",
      "who": "",
      "text": "西口外，乡亲们趴在田里咳嗽。人数了两遍。",
      "voice": "Narrator",
      "dur": 5.28
    },
    {
      "id": "0s4wwj3",
      "who": "",
      "text": "顺子没出来。拴柱大爷也没有。",
      "voice": "Narrator",
      "dur": 3.98
    },
    {
      "id": "0s74noo",
      "who": "",
      "text": "柱子站在出口，看着被抬出来的乡亲，一句话也说不出。",
      "voice": "Narrator",
      "dur": 5.56
    },
    {
      "id": "1f0lp5e",
      "who": "",
      "text": "柱子背起工具，跟着队伍再次下了地道。",
      "voice": "Narrator",
      "dur": 3.85
    },
    {
      "id": "160632l",
      "who": "",
      "text": "东口封死了。第二天起，全村轮班下洞。",
      "voice": "Narrator",
      "dur": 4.88
    },
    {
      "id": "0p4w3r9",
      "who": "",
      "text": "高传宝在门板上画了三个记号：翻口，新暗口，预警铃。",
      "voice": "Narrator",
      "dur": 6.08
    },
    {
      "id": "0ydpwx3",
      "who": "",
      "text": "柱子的墨斗和刨子，成了地道里的家伙什。",
      "voice": "Narrator",
      "dur": 4.08
    },
    {
      "id": "1b12oee",
      "who": "",
      "text": "白天，两个伪军就在村里翻翻捡捡地转。头顶的脚步，地道里听得一清二楚。",
      "voice": "Narrator",
      "dur": 8.54
    },
    {
      "id": "09q498f",
      "who": "",
      "text": "没过几天，鬼子又来了。还是老一套：堵口，灌烟。",
      "voice": "Narrator",
      "dur": 5.81
    },
    {
      "id": "09a4z1d",
      "who": "",
      "text": "烟堵在弯里，一夜没退。地面上，什么也看不出来。",
      "voice": "Narrator",
      "dur": 5.74
    },
    {
      "id": "0ffp4o7",
      "who": "",
      "text": "鬼子在村里翻到天黑，一个人也没找到。",
      "voice": "Narrator",
      "dur": 4.08
    },
    {
      "id": "1bbsa2u",
      "who": "",
      "text": "撤下来的时候，一个年轻民兵被塌下的土石压住了腿。",
      "voice": "Narrator",
      "dur": 5.46
    },
    {
      "id": "1f26mgy",
      "who": "",
      "text": "鬼子的探杆就在头顶上戳。谁也不敢出声。",
      "voice": "Narrator",
      "dur": 4.99
    },
    {
      "id": "0drwo1y",
      "who": "",
      "text": "那只手从土里伸出来，把柱子推开了。",
      "voice": "Narrator",
      "dur": 3.94
    },
    {
      "id": "0xtc3zj",
      "who": "",
      "text": "他把手里的枪递出去，朝洞外摆了摆手。",
      "voice": "Narrator",
      "dur": 3.93
    },
    {
      "id": "0h5axpo",
      "who": "",
      "text": "押送定在后天。据点里外都加了岗。",
      "voice": "Narrator",
      "dur": 4.23
    },
    {
      "id": "154hijw",
      "who": "",
      "text": "高传宝的法子是两头一起动：地面上打出动静把人引开，地下从地道把乡亲接走。",
      "voice": "Narrator",
      "dur": 8.4
    },
    {
      "id": "08y5vfr",
      "who": "",
      "text": "高传宝把柱子叫住，让他先去看清楚。",
      "voice": "Narrator",
      "dur": 4.15
    },
    {
      "id": "04e4qsr",
      "who": "",
      "text": "南门加了双岗。换岗的时候，背还是朝着庄稼地。",
      "voice": "Narrator",
      "dur": 5.71
    },
    {
      "id": "15qg6hs",
      "who": "",
      "text": "牢房外多了一个游动哨，绕到北墙要一袋烟的工夫。",
      "voice": "Narrator",
      "dur": 5.17
    },
    {
      "id": "1nuioe9",
      "who": "",
      "text": "那辆骡车还拴在原处。车辕上一直空着。",
      "voice": "Narrator",
      "dur": 4.72
    },
    {
      "id": "0uuvsxz",
      "who": "",
      "text": "柱子指了指门板上钉在一起的那两条。",
      "voice": "Narrator",
      "dur": 3.85
    },
    {
      "id": "06fm3db",
      "who": "",
      "text": "屋里安静了一会儿。",
      "voice": "Narrator",
      "dur": 1.85
    },
    {
      "id": "0ovpn66",
      "who": "",
      "text": "柱子说不上来。",
      "voice": "Narrator",
      "dur": 1.51
    },
    {
      "id": "1ox0i4n",
      "who": "",
      "text": "高传宝在门板上把日子和那辆骡车圈到了一起。",
      "voice": "Narrator",
      "dur": 4.96
    },
    {
      "id": "1fqp8iq",
      "who": "",
      "text": "行动前夜。油灯把门板图照得发黄。",
      "voice": "Narrator",
      "dur": 4.34
    },
    {
      "id": "1t92ulg",
      "who": "",
      "text": "柱子站在图前，指着据点的方向。",
      "voice": "Narrator",
      "dur": 3.33
    },
    {
      "id": "0issfvm",
      "who": "",
      "text": "高传宝看了他一眼。没有劝。",
      "voice": "Narrator",
      "dur": 3.57
    },
    {
      "id": "1jhny3r",
      "who": "",
      "text": "二更天，村北先响了枪。柱子在那头。",
      "voice": "Narrator",
      "dur": 4.64
    },
    {
      "id": "1ltepi5",
      "who": "",
      "text": "据点岗楼上的灯全甩向北面。巡逻队跑步出了南门。",
      "voice": "Narrator",
      "dur": 6.01
    },
    {
      "id": "0wovr15",
      "who": "",
      "text": "枪声把人引出去多远，地底下就多出多少工夫。",
      "voice": "Narrator",
      "dur": 4.81
    },
    {
      "id": "0twhnvd",
      "who": "",
      "text": "打完那一阵，他才从北边退回来下的地道。接应组已经走在前头了。",
      "voice": "Narrator",
      "dur": 7.49
    },
    {
      "id": "0yi9nnu",
      "who": "",
      "text": "区上武工队来了两个班。佯动组已经摸到村北去了——这边不动，人从地下走。",
      "voice": "Narrator",
      "dur": 8.56
    },
    {
      "id": "1bimod6",
      "who": "",
      "text": "二更天，地道里一盏灯也没点。",
      "voice": "Narrator",
      "dur": 3.13
    },
    {
      "id": "134r6ls",
      "who": "",
      "text": "队伍在黑暗里贴着墙根移动，谁也不说话。",
      "voice": "Narrator",
      "dur": 4.33
    },
    {
      "id": "1lbh33p",
      "who": "",
      "text": "这条道原本只到墙外的地里。最后那十几步，是这三天连夜掏出来的。",
      "voice": "Narrator",
      "dur": 7.79
    },
    {
      "id": "1hxugme",
      "who": "",
      "text": "柱子数着步子。掏到牢房地沿，还有两处虚土要清。",
      "voice": "Narrator",
      "dur": 5.91
    },
    {
      "id": "0yvsckb",
      "who": "",
      "text": "地沿的木板被顶开一条缝。霉味和哭声一起漏下来。",
      "voice": "Narrator",
      "dur": 6.03
    },
    {
      "id": "1dfiyve",
      "who": "",
      "text": "民兵一个个往下接人。柱子在人堆里看见了妹妹。",
      "voice": "Narrator",
      "dur": 5.46
    },
    {
      "id": "1uvz4wd",
      "who": "",
      "text": "妹妹瘦得脱了相。她抓住柱子的袖子。",
      "voice": "Narrator",
      "dur": 4.11
    },
    {
      "id": "0phwy7f",
      "who": "",
      "text": "柱子没有说话。",
      "voice": "Narrator",
      "dur": 1.47
    },
    {
      "id": "0s9x14p",
      "who": "",
      "text": "妹妹看着哥哥的眼睛，慢慢松开了手，又慢慢把额头抵在他肩上。",
      "voice": "Narrator",
      "dur": 6.52
    },
    {
      "id": "1xyvxnf",
      "who": "",
      "text": "她明白了。",
      "voice": "Narrator",
      "dur": 0.85
    },
    {
      "id": "1c4abg1",
      "who": "",
      "text": "入口上面就是庄稼地，就是活路。",
      "voice": "Narrator",
      "dur": 3.32
    },
    {
      "id": "0bu0lf6",
      "who": "",
      "text": "一个民兵跌跌撞撞从地道里追出来。",
      "voice": "Narrator",
      "dur": 3.66
    },
    {
      "id": "0kg4h88",
      "who": "",
      "text": "头顶上，搜查的脚步声越来越密。",
      "voice": "Narrator",
      "dur": 3.38
    },
    {
      "id": "1bcncf2",
      "who": "",
      "text": "最后一个乡亲被推出洞口的时候，东边天已经泛白。",
      "voice": "Narrator",
      "dur": 5.38
    },
    {
      "id": "0wi6bmn",
      "who": "",
      "text": "人数了三遍。一个不少。",
      "voice": "Narrator",
      "dur": 2.89
    },
    {
      "id": "19d7nys",
      "who": "",
      "text": "柱子坐在田埂上，灯芯已经烧到了头。",
      "voice": "Narrator",
      "dur": 3.91
    },
    {
      "id": "0ygzbsy",
      "who": "",
      "text": "他把灯吹灭了。",
      "voice": "Narrator",
      "dur": 1.62
    },
    {
      "id": "1mp762g",
      "who": "",
      "text": "天亮了。",
      "voice": "Narrator",
      "dur": 0.71
    },
    {
      "id": "1hkpkjb",
      "who": "",
      "text": "一个月后。",
      "voice": "Narrator",
      "dur": 0.91
    },
    {
      "id": "0wbu7yt",
      "who": "",
      "text": "沙河庄的地道重新修整。被发现的口子封死了，新口挖在另一片庄稼地旁。",
      "voice": "Narrator",
      "dur": 8.26
    },
    {
      "id": "0njcj2r",
      "who": "",
      "text": "乡亲们把废弃的旧口填平。那块地方，正是当年柱子第一次找到妹妹的地方。",
      "voice": "Narrator",
      "dur": 8.1
    },
    {
      "id": "1tjwidj",
      "who": "",
      "text": "柱子带着妹妹，回了一趟梁家村。",
      "voice": "Narrator",
      "dur": 3.23
    },
    {
      "id": "0aa6lx7",
      "who": "",
      "text": "院子烧毁了。只剩一堵残墙。",
      "voice": "Narrator",
      "dur": 3.6
    },
    {
      "id": "0nsfpsl",
      "who": "",
      "text": "门框还在。",
      "voice": "Narrator",
      "dur": 1.13
    },
    {
      "id": "1v4oq3o",
      "who": "",
      "text": "妹妹走过去，伸手摸了一下爹刻的那道线。",
      "voice": "Narrator",
      "dur": 4.4
    },
    {
      "id": "0cknfx2",
      "who": "",
      "text": "她的手停了一会儿。",
      "voice": "Narrator",
      "dur": 1.85
    },
    {
      "id": "1jmrnvz",
      "who": "",
      "text": "院外传来民兵喊他的声音。",
      "voice": "Narrator",
      "dur": 2.82
    },
    {
      "id": "1qwk3y8",
      "who": "",
      "text": "柱子放下工具，回头看了一眼妹妹。",
      "voice": "Narrator",
      "dur": 3.51
    },
    {
      "id": "1gwsgab",
      "who": "",
      "text": "妹妹抱着爹留下的旧木凳，点了点头。",
      "voice": "Narrator",
      "dur": 3.67
    },
    {
      "id": "1mcw34k",
      "who": "",
      "text": "柱子走出院子。",
      "voice": "Narrator",
      "dur": 1.46
    },
    {
      "id": "07zc9x0",
      "who": "",
      "text": "门框上的两道刻痕，留在了身后。",
      "voice": "Narrator",
      "dur": 3.32
    },
    {
      "id": "1hik0yg",
      "who": "",
      "text": "扶着民兵的老人抬起头，借着灯光认出了他。",
      "voice": "Narrator",
      "dur": 4.24
    },
    {
      "id": "0k2jzu7",
      "who": "",
      "text": "老人松了一口气。",
      "voice": "Narrator",
      "dur": 1.83
    }
  ],
