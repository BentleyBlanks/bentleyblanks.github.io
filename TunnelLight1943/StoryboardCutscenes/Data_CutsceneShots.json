        {"id":"57","file":"Texture_C1Rescue01_FeedWater.jpg","beat":"c1_rescue","dur":"长按托稳","cam":"insert","picture":"把瓢托在他嘴边。喝得急，中途呛一下。","line":""},
        {"id":"58","file":"Texture_C1Rescue02_DarkFingertip.jpg","beat":"c1_rescue","dur":"4.0s","cam":"insert","picture":"月光从板缝照下来——指尖是一片暗色。","line":""},
