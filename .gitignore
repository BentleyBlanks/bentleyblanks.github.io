# Claude Code local settings (may contain secrets)
.claude/settings.local.json

# 带斜杠只匹配目录。worktree 里为了复用主检出的依赖常会建一个同名软链
# （mode 120000），那种形态不被 node_modules/ 匹配，会被 git add -A 收进来。
# 推上去就是一条指向本机绝对路径的断链，Jekyll 解析它时整个 Pages 构建会挂：
#   Error: No such file or directory @ rb_check_realpath_internal - /github/workspace/node_modules
# 两种形态都要挡。
node_modules
node_modules/
# 仓库约定不落 lockfile（纯静态站，只有测试用 devDependencies）
package-lock.json
sophia-awakening/_dev/dist/
sophia-awakening/_dev/.sim-build/
sophia-awakening/_dev/.sim-build-kangri/
sophia-awakening/_dev/public/
sophia-awakening/assets/audio/
tmp/
.vite/
**/desktop.ini

# Local Codex bridge/watchdog infra (machine-local, not part of the site)
.codex-tmp/

# Local Civilization VI reference audio; do not publish or redistribute.
/taihang/assets/audio/local-civ6/

# TunnelBell1942 调试临时文件（agent 跑 trace 用，不进仓库）
TunnelBell1942/*_tmp.mjs
Screens_TunnelBell/
TunnelLight1943/_shots/
# 视频转骨骼（Script_MocapTrack.py）的逐帧叠图/CSV 不进仓库；源片、导出的轨道、对比图留着
TunnelLight1943/_mocap/*
!TunnelLight1943/_mocap/*.mp4
!TunnelLight1943/_mocap/*.track.mjs
!TunnelLight1943/_mocap/compare_*.jpg
# 第一章分镜参考图（从 Notion 拉下来的成品插画，只用来照着还原机位，不进仓库）
TunnelLight1943/VideoBoard/_c1refs/
# 音效烘焙的原始素材（每段 1-6MB 的生成长片，切完就没用了；成品在 Audio/Sfx/*.mp3）
TunnelLight1943/Audio/Sfx/_raw/
Taierzhuang1938/Audio/Sfx/_raw/
Taierzhuang1938/Audio/Amb/_raw/
Taierzhuang1938/Audio/Music/_raw/
Taierzhuang1938/Heightmap/_raw/
# Taierzhuang1938 视觉审查用的截图（每轮重出，不进仓库）
Taierzhuang1938/_shots/
# Train acceptance pages and media are local only, never Pages assets.
# New Blender source projects belong in OneDrive/AI/Models/Blender.
*.blend
*.blend[0-9]*
Taierzhuang1938/Model/TrainReference/_review/
Taierzhuang1938/Model/TrainReference/index.html
Taierzhuang1938/Model/TrainReference/Script_TrainReview.mjs
Taierzhuang1938/Model/TrainReference/Animation_*.mp4
Taierzhuang1938/Model/TrainReference/Texture_*Runtime.png
Taierzhuang1938/Model/TrainReference/Texture_TrainHero.png
Taierzhuang1938/Model/TrainReference/Data_BuildProgress.txt
Taierzhuang1938/Model/TrainReference/*.blend1
Taierzhuang1938/Model/TrainReference/__pycache__/
Taierzhuang1938/_check_*.html
# 视频转骨骼的中间产物：只留关键点 JSON（重烘 clip 的输入），叠帧 QC 图不进仓库
Taierzhuang1938/_import/_mocap/*
!Taierzhuang1938/_import/_mocap/*.mocap.json
Taierzhuang1938/_import/__pycache__/
